@using ClinicMVC.ViewModels.Doctor
@model DoctorUpdateVm

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Update Product</h6>
        <a asp-action="Index" asp-controller="Product" class="btn btn-outline-primary ml-auto">Return List</a>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="Name">Name*</label>
                <input required value="@Model.Name" asp-for="Name" class="form-control">
                <span asp-validation-for="Name" class="text-small text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Surname">Description*</label>
                <input required value="@Model.Surname" asp-for="Surname" class="form-control">
                <span asp-validation-for="Surname" class="text-small text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Position">CostPrice</label>
                <input required value="@Model.Position" asp-for="Position" class="form-control">
                <span asp-validation-for="Position" class="text-small text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Department">SellPrice</label>
                <input required value="@Model.Department" asp-for="Department" class="form-control">
                <span asp-validation-for="Department" class="text-small text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="DepartmentId">CategoryId*</label>
                <select asp-for="DepartmentId" class="form-control">
                    <option selected disabled>Select Category</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-small text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
        </form>
    </div>
</div>
